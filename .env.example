# Application Configuration
APP_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug

# Redis Configuration
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL Configuration
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/teztynda?sslmode=disable

# AI Providers ("fake" or "deepgram" / "openai")
STT_PROVIDER=fake
DEEPGRAM_API_KEY=your_deepgram_api_key_here

LLM_PROVIDER=fake
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Memory & Token Limits
MAX_CONTEXT_TOKENS=3000
SHORT_MEMORY_TOKENS=1000
